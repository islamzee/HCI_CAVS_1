# Settings for pod.sh on this machine (e.g. the MTX).
# Copy this file to pod.env in the same folder and change the paths:
#   cp pod.env.example pod.env
# One setting per line, no spaces around "=" and no quotes. Lines starting with # are ignored.
# pod.env is not committed, so each machine keeps its own.

# Bag folder: the one with metadata.yaml and the .mcap file (full path)
BAG_DIR=/home/mtx/bags/their_bag

# Image loaded from the drive with "podman load" (no internet needed)
IMAGE=ghcr.io/islamzee/hci_cavs_1/cavs-bag-bridge:latest

# Optional
#PORT=8765
#RATE=1.0
